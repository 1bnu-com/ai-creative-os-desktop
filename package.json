{
  "name": "ai-creative-os-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "AI Creative OS hybrid desktop with safe local data and release updater",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "pack:win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.aicreativeos.desktop",
    "productName": "AI Creative OS Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "style.css",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SET_GITHUB_OWNER",
        "repo": "SET_GITHUB_REPO",
        "releaseType": "release"
      }
    ]
  }
}